# --- CloudEvents (research.md §3) ---
BACKEND_CLOUDEVENTS_SOURCE=https://fluxip.example.com
BACKEND_CLOUDEVENTS_TYPE_PREFIX=space.kyro.fluxip

# --- Account defaults (research.md §16, FR-033) ---
BACKEND_DEFAULT_IP_CLIENT_LIMIT=5

# --- Action execution retry/backoff (research.md §5, FR-021) ---
BACKEND_ACTION_RETRY_ATTEMPTS=5
BACKEND_ACTION_RETRY_BASE_DELAY_MS=30000

# --- IP flapping debounce (research.md §6, FR-024) ---
BACKEND_IP_CLIENT_DEBOUNCE_MS=30000

# --- Postgres (event store) ---
BACKEND_DATABASE_URL=postgresql://fluxip:fluxip@localhost:5432/fluxip

# --- Redis (BullMQ + projections) ---
BACKEND_REDIS_URL=redis://localhost:6379

# --- Logto (OIDC authentication, research.md §7) ---
BACKEND_LOGTO_ENDPOINT=http://localhost:3001
BACKEND_LOGTO_APP_ID=
BACKEND_LOGTO_APP_SECRET=

# --- Logto Management API (in-app password change, research.md §15) ---
BACKEND_LOGTO_MANAGEMENT_CLIENT_ID=
BACKEND_LOGTO_MANAGEMENT_CLIENT_SECRET=

BACKEND_LOGTO_MANAGEMENT_API_BASE_URL=http://localhost:3002

# --- HTTP server ---
BACKEND_PORT=8080

# --- Provider Credential encryption at rest (data-model.md provider_credential) ---
# 32 random bytes, base64-encoded, e.g.: openssl rand -base64 32
BACKEND_CREDENTIAL_ENCRYPTION_KEY=

# --- Hetzner DNS action adapter ---
# (Per-user Hetzner Cloud API tokens are stored as Provider Credentials at
#  runtime, not configured here — this is deployment-level config only. Only
#  Hetzner Cloud API tokens are accepted; the older, separate DNS Console/API
#  token format is not, per FR-035.)

# --- Email notifications (research.md §13, FR-030/FR-031) ---
# Per-account destination addresses are stored as a notification_channel
# aggregate at runtime, not here — these are the deployment-level SMTP
# relay/transport settings (e.g. point at a MailHog container for local dev).
BACKEND_SMTP_HOST=localhost
BACKEND_SMTP_PORT=1025
BACKEND_SMTP_USER=
BACKEND_SMTP_PASSWORD=
BACKEND_SMTP_SECURE=false
BACKEND_NOTIFICATION_FROM_ADDRESS=fluxip@localhost

# --- Operational logging (specs/005-observability-logging) ---
# BACKEND_APP_LOG_LEVEL: lowest level recorded for the Application Log (stdout): debug|info|warning|error|fatal
BACKEND_APP_LOG_LEVEL=info
# BACKEND_ACCESS_LOG_FILE_PATH: rotating Access Log file path (relative to the backend process's working directory)
BACKEND_ACCESS_LOG_FILE_PATH=logs/access.log
# BACKEND_ACCESS_LOG_MAX_SIZE_BYTES: rotate once the file exceeds this size (default: 10 MiB)
BACKEND_ACCESS_LOG_MAX_SIZE_BYTES=10485760
# BACKEND_ACCESS_LOG_MAX_FILES: number of rotated files retained (.1..N) before the oldest is discarded
BACKEND_ACCESS_LOG_MAX_FILES=5


# --- Frontend runtime configuration (specs/006-frontend-runtime-config) ---
# Consumed only by the frontend role's container-start entrypoint, not the
# backend — kept FRONTEND_-prefixed so they don't collide with the backend's
# own BACKEND_LOGTO_* vars above, which are a different Logto application/purpose.
FRONTEND_LOGTO_ENDPOINT=
FRONTEND_LOGTO_APP_ID=
FRONTEND_LOGTO_API_RESOURCE=
FRONTEND_BACKEND_URL=


# --- Logto (OIDC sign-in, frontend) ---
# Same Logto tenant as the backend's BACKEND_LOGTO_ENDPOINT (see root .env.example).
VITE_LOGTO_ENDPOINT=https://auth.logto.kyro.space

# Client ID of a dedicated Logto Application for this frontend
# (type: Single Page App / public client, no secret). Register it in the
# Logto Console with these Redirect URIs for local dev:
#   Redirect URI:             http://localhost:5173/callback
#   Post sign-out redirect URI: http://localhost:5173
VITE_LOGTO_APP_ID=
