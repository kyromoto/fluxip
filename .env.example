# --- CloudEvents (research.md §3) ---
CLOUDEVENTS_SOURCE=https://fluxip.example.com
CLOUDEVENTS_TYPE_PREFIX=space.kyro.fluxip

# --- Account defaults (research.md §16, FR-033) ---
DEFAULT_IP_CLIENT_LIMIT=5

# --- Action execution retry/backoff (research.md §5, FR-021) ---
ACTION_RETRY_ATTEMPTS=5
ACTION_RETRY_BASE_DELAY_MS=30000

# --- IP flapping debounce (research.md §6, FR-024) ---
IP_CLIENT_DEBOUNCE_MS=30000

# --- Postgres (event store) ---
DATABASE_URL=postgresql://fluxip:fluxip@localhost:5432/fluxip

# --- Redis (BullMQ + projections) ---
REDIS_URL=redis://localhost:6379

# --- Logto (OIDC authentication, research.md §7) ---
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_APP_ID=
LOGTO_APP_SECRET=

# --- Logto Management API (in-app password change, research.md §15) ---
LOGTO_MANAGEMENT_CLIENT_ID=
LOGTO_MANAGEMENT_CLIENT_SECRET=
LOGTO_MANAGEMENT_API_BASE_URL=http://localhost:3002

# --- HTTP server ---
PORT=8080

# --- Provider Credential encryption at rest (data-model.md provider_credential) ---
# 32 random bytes, base64-encoded, e.g.: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# --- Hetzner DNS action adapter ---
# (Per-user Hetzner API tokens are stored as Provider Credentials at runtime,
#  not configured here — this is deployment-level config only.)

# --- Email notifications (research.md §13, FR-030/FR-031) ---
# Per-account destination addresses are stored as a notification_channel
# aggregate at runtime, not here — these are the deployment-level SMTP
# relay/transport settings (e.g. point at a MailHog container for local dev).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
NOTIFICATION_FROM_ADDRESS=fluxip@localhost

# --- Operational logging (specs/005-observability-logging) ---
# APP_LOG_LEVEL: lowest level recorded for the Application Log (stdout): debug|info|warning|error|fatal
APP_LOG_LEVEL=info
# ACCESS_LOG_FILE_PATH: rotating Access Log file path (relative to the backend process's working directory)
ACCESS_LOG_FILE_PATH=logs/access.log
# ACCESS_LOG_MAX_SIZE_BYTES: rotate once the file exceeds this size (default: 10 MiB)
ACCESS_LOG_MAX_SIZE_BYTES=10485760
# ACCESS_LOG_MAX_FILES: number of rotated files retained (.1..N) before the oldest is discarded
ACCESS_LOG_MAX_FILES=5



# --- Logto (OIDC sign-in, frontend) ---
# Same Logto tenant as the backend's LOGTO_ENDPOINT (see root .env.example).
VITE_LOGTO_ENDPOINT=https://auth.logto.kyro.space

# Client ID of a dedicated Logto Application for this frontend
# (type: Single Page App / public client, no secret). Register it in the
# Logto Console with these Redirect URIs for local dev:
#   Redirect URI:             http://localhost:5173/callback
#   Post sign-out redirect URI: http://localhost:5173
VITE_LOGTO_APP_ID=
